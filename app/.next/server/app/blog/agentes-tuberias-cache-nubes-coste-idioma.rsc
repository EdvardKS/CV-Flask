f:I[9823,["9823","static/chunks/9823-b28cb82c5656e422.js","5953","static/chunks/app/blog/%5Bslug%5D/page-3d84705274ccbc3a.js"],""]
4:["$","div",null,{"className":"doc-page","children":[["$","script",null,{"dangerouslySetInnerHTML":{"__html":"if(window.self!==window.top)document.documentElement.classList.add('is-embedded')"}}],["$","header",null,{"className":"doc-top","children":[["$","$Lf",null,{"href":"/","className":"doc-brand","children":["EdvardKS ",["$","span",null,{"children":"PC"}]]}],["$","nav",null,{"aria-label":"Secciones","children":[["$","$Lf","/",{"href":"/","children":"Escritorio"}],["$","$Lf","/projects",{"href":"/projects","children":"Proyectos"}],["$","$Lf","/blog",{"href":"/blog","children":"Blog"}],["$","$Lf","/cv",{"href":"/cv","children":"CV"}],["$","$Lf","/contact",{"href":"/contact","children":"Contacto"}]]}]]}],["$","main",null,{"className":"doc-main","children":[["$","nav",null,{"className":"doc-crumbs","aria-label":"Ruta","children":[["$","$Lf",null,{"href":"/","children":"Inicio"}],["$","span",null,{"children":"/"}],["$","$Lf",null,{"href":"/blog","children":"Blog"}]]}],["$","article",null,{"className":"doc-article","children":[["$","p",null,{"className":"doc-eyebrow","children":["Big data"," · ","2026-11-09"," · ",6," min"]}],["$","h1",null,{"children":"Agentes que arreglan tuberías, caché entre nubes y lo que cuesta no hablar inglés"}],["$","p",null,{"className":"doc-lead","children":"Snowflake lanza agentes que proponen arreglos de tuberías, BigQuery cachea datos entre nubes y un estudio mide cuánta energía extra gasta la IA fuera del inglés."}],["$","figure",null,{"className":"doc-figure","children":[["$","img",null,{"className":"doc-cover","src":"/blog/agentes-tuberias-cache-nubes-coste-idioma.webp","alt":"Filas de armarios de servidores en un centro de datos","width":1280,"height":800}],["$","figcaption",null,{"children":["Foto:"," ",["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:Technician_with_laptop_working_on_server_rack_at_NERSC.jpg","target":"_blank","rel":"noopener nofollow","children":"Derrick Coetzee from Berkeley, CA, USA, CC0, vía Wikimedia Commons"}]]}]]}],[["$","p","0",{"children":"Esta semana he elegido tres noticias que tocan el trabajo diario más que el escaparate. Una va de agentes que vigilan tuberías de datos, otra de lo que cuesta mover datos entre nubes y la tercera de algo que en España solemos pasar por alto: hacer preguntas a un modelo en un idioma que no es el inglés tiene un coste. Ninguna de las tres es épica, pero las tres cambian decisiones que tomo con clientes."}],["$","h2","1",{"children":"Snowflake pone agentes a revisar tuberías, pero el humano aprueba"}],["$","p","2",{"children":"El 3 de noviembre de 2026, en su evento Expedition, Snowflake anunció un paquete que llama ingeniería de datos autónoma. Sus agentes CoCo pueden ejecutarse en contenedores aislados gestionados por Snowflake en lugar de en el portátil del ingeniero, programar tareas recurrentes como revisar la salud de una tubería o investigar trabajos fallidos, y trabajar con un alcance de sesión restringido; estas tres piezas salen ya como disponibilidad general. Según la nota, el agente busca la causa probable del fallo, propone un arreglo y el ingeniero decide qué pasa a producción; los cambios por GitHub siguen el proceso de revisión habitual del equipo. Las cifras que acompañan el anuncio, como una latencia mediana de 3 segundos hasta tener el dato listo o hasta 20 GB/s por tabla en streaming, salen de pruebas internas de la propia Snowflake y de testimonios de sus clientes, sin verificación de terceros."}],["$","p","3",{"children":"Mi opinión: Lo que me interesa no es la palabra autónoma, que es marketing, sino el diseño que hay debajo: entorno aislado, permisos recortados, tareas programadas y aprobación humana antes de producción. Es justo el orden que sigo cuando dejo a un agente tocar algo que importa, y me alegra ver que un proveedor grande lo convierte en producto en vez de vender un botón mágico. Para una pyme de la zona, Snowflake suele ser más plataforma de la que necesita, pero el patrón se puede copiar con herramientas modestas: un agente que lee registros de las ETL, propone el arreglo en una rama y espera a que yo lo revise. Las cifras de latencia y de ahorro no las doy por buenas hasta verlas medidas fuera de la casa. Y me quedo con una duda práctica: cuánto cuesta en créditos tener agentes revisando tuberías cada hora, porque eso la nota no lo dice."}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18"]]}],"$L19",["$L1a","$L1b"]]}],"$L1c"]}]
10:["$","h2","4",{"children":"BigQuery cachea datos de otras nubes para recortar la salida"}]
11:["$","p","5",{"children":"Las notas de versión de BigQuery recogen que el 2 de noviembre de 2026 pasó a disponibilidad general la caché entre nubes de su Lakehouse. Viene desactivada por defecto y, si se activa sobre un catálogo federado o una conexión entre nubes, guarda copia de los ficheros remotos en una región de Google Cloud para reducir los costes de salida de datos y acelerar las consultas siguientes. Ese mismo día también quedó en disponibilidad general el acceso entre nubes a catálogos como Databricks Unity Catalog, AWS Glue Data Catalog y Snowflake Horizon Catalog, con opción de ir por internet público o por interconexión privada y controles de servicio de VPC. Es documentación oficial de Google, así que describe lo que hace la función, no cuánto ahorra en la práctica."}]
12:["$","p","6",{"children":"Mi opinión: El coste de salida de datos es la factura que nadie mira hasta que llega, y es una de las razones por las que muchas arquitecturas acaban atadas a una sola nube. Que BigQuery pueda leer catálogos de otros proveedores y cachear lo que trae va en la línea que defiendo: poder cambiar de pieza sin mover todo el dato de golpe. Me gusta que venga apagada por defecto, porque una caché es una copia más del dato y eso tiene implicaciones de gobierno y de dónde reside la información. Antes de activarla en un proyecto real quiero entender bien cómo se invalida cuando el fichero de origen cambia, porque una consulta rápida sobre datos viejos es peor que una consulta lenta. No lo he probado todavía, así que mi siguiente paso sería medir la factura de salida con y sin caché sobre una carga conocida."}]
13:["$","h2","7",{"children":"Preguntar a un modelo fuera del inglés gasta más y acierta menos"}]
14:["$","p","8",{"children":"El 5 de noviembre de 2026 la Universidad de Míchigan difundió un estudio, presentado en la conferencia EMNLP, que mide la energía de inferencia de modelos de lenguaje en distintos idiomas. Probaron tres modelos abiertos, Qwen 3, Gemma 3 y Llama 3.1, con preguntas de comprensión lectora en 122 idiomas y problemas de matemáticas traducidos, midiendo el consumo con el marco ML.Energy. Según la nota, generar texto en idiomas distintos del inglés gasta entre 1,4 y 180 veces más energía, con la mayoría de lenguas de Europa occidental en el doble o menos, y los idiomas que más gastan tienden además a obtener peor precisión. La causa principal que señalan es que esos textos necesitan más tokens, lo que también encarece los servicios que cobran por token. La nota no da cifras concretas para el español."}]
15:["$","p","9",{"children":"Mi opinión: Este estudio me parece más útil para una pyme española que muchos lanzamientos de modelos, porque toca dos cosas que sí pagan: la factura por token y la calidad de la respuesta. Si el español cae en la franja de hasta el doble que el inglés, un asistente interno o un sistema RAG puede costar bastante más de lo que sugiere una calculadora hecha con ejemplos en inglés. La lección práctica que saco es medir con los textos reales del cliente, en su idioma, tanto los tokens por consulta como los aciertos, y no extrapolar de pruebas en inglés. También me reafirma en evaluar los modelos en local con nuestro propio idioma antes de elegir, porque el tokenizador importa tanto como el tamaño del modelo. Lo de traducir la pregunta al inglés que proponen los autores lo veo con cautela: añade un paso que puede introducir errores y que habría que medir igual que todo lo demás."}]
16:["$","h2","10",{"children":"Lo que me llevo"}]
17:["$","ul","11",{"className":"doc-list","children":[["$","li","Si dejo a un agente vigilar tuberías de datos, lo hago con entorno aislado, permisos mínimos y aprobación humana antes de producción, lo venda quien lo venda.",{"children":"Si dejo a un agente vigilar tuberías de datos, lo hago con entorno aislado, permisos mínimos y aprobación humana antes de producción, lo venda quien lo venda."}],["$","li","Las cifras de latencia y de ahorro de un proveedor sobre su producto no entran en mis decisiones hasta verlas medidas fuera de la casa.",{"children":"Las cifras de latencia y de ahorro de un proveedor sobre su producto no entran en mis decisiones hasta verlas medidas fuera de la casa."}],["$","li","Antes de diseñar una arquitectura entre nubes calculo el coste de salida de datos, y si uso una caché compruebo cómo se invalida.",{"children":"Antes de diseñar una arquitectura entre nubes calculo el coste de salida de datos, y si uso una caché compruebo cómo se invalida."}],["$","li","Mido tokens por consulta y precisión con textos reales en español del cliente, no con ejemplos en inglés.",{"children":"Mido tokens por consulta y precisión con textos reales en español del cliente, no con ejemplos en inglés."}],["$","li","Al comparar modelos, sobre todo en local, evalúo también el tokenizador en mi idioma, no solo el tamaño o el benchmark.",{"children":"Al comparar modelos, sobre todo en local, evalúo también el tokenizador en mi idioma, no solo el tamaño o el benchmark."}]]}]
18:["$","aside","12",{"className":"doc-links","children":[["$","h2",null,{"children":"Fuentes"}],["$","ul",null,{"children":[["$","li","https://www.snowflake.com/en/news/press-releases/expedition-2026-autonomous-data-engineering/",{"children":["$","a",null,{"href":"https://www.snowflake.com/en/news/press-releases/expedition-2026-autonomous-data-engineering/","target":"_blank","rel":"noopener","children":"Snowflake: «Snowflake Delivers the Foundation for Autonomous Data Engineering»"}]}],["$","li","https://docs.cloud.google.com/bigquery/docs/release-notes",{"children":["$","a",null,{"href":"https://docs.cloud.google.com/bigquery/docs/release-notes","target":"_blank","rel":"noopener","children":"Google Cloud: notas de versión de BigQuery (2 de noviembre de 2026)"}]}],["$","li","https://www.eurekalert.org/news-releases/1150646",{"children":["$","a",null,{"href":"https://www.eurekalert.org/news-releases/1150646","target":"_blank","rel":"noopener","children":"EurekAlert / Universidad de Míchigan: «Generative AI uses more energy on non-English text»"}]}]]}]]}]
19:["$","section",null,{"className":"doc-related","children":[["$","h2",null,{"children":"Más entradas"}],["$","ul",null,{"children":[["$","li","spark-tiempo-real-mistral-large-4-bigquery-git",{"children":["$","$Lf",null,{"href":"/blog/spark-tiempo-real-mistral-large-4-bigquery-git","children":[["$","strong",null,{"children":"Spark en tiempo real sin Flink, Mistral Large 4 abierto y BigQuery con Git"}],["$","span",null,{"children":"Databricks saca de beta el modo en tiempo real de Spark, Mistral libera los pesos de Large 4 y BigQuery integra Git. Lo que cambia y lo que todavía no me creo."}]]}]}],["$","li","duckdb-2-torchtpu-revision-codigo-agentes",{"children":["$","$Lf",null,{"href":"/blog/duckdb-2-torchtpu-revision-codigo-agentes","children":[["$","strong",null,{"children":"DuckDB 2.0 ya hace de servidor, PyTorch llega a las TPU y la revisión de código frena"}],["$","span",null,{"children":"DuckDB 2.0 estrena modo servidor, Google y Meta abren TorchTPU y un estudio de 718 empresas muestra que los agentes de IA trasladan el atasco a la revisión de código."}]]}]}],["$","li","transacciones-databricks-muse-spark-cma-nube",{"children":["$","$Lf",null,{"href":"/blog/transacciones-databricks-muse-spark-cma-nube","children":[["$","strong",null,{"children":"Transacciones en Databricks, Meta abre Muse Spark y el regulador británico aprieta"}],["$","span",null,{"children":"Tres noticias de la semana: transacciones multisentencia en Databricks, el modelo abierto Muse Spark Open de Meta y la revisión de la CMA sobre cambiar de nube."}]]}]}],["$","li","migrar-eks-gke-spark-derroche-pytorch-215",{"children":["$","$Lf",null,{"href":"/blog/migrar-eks-gke-spark-derroche-pytorch-215","children":[["$","strong",null,{"children":"Migrar de EKS a GKE con un agente, Spark que derrocha y PyTorch 2.15 a prueba"}],["$","span",null,{"children":"Esta semana: el agente de Google para migrar de EKS a GKE, el 31 % de ahorro en Spark que cuenta Salesforce y la candidata de PyTorch 2.15. Mi lectura práctica."}]]}]}],["$","li","lo-que-pienso-de-la-ia-otono-2026",{"children":["$","$Lf",null,{"href":"/blog/lo-que-pienso-de-la-ia-otono-2026","children":[["$","strong",null,{"children":"Lo que pienso de la IA este otoño: España, Europa y Silicon Valley"}],["$","span",null,{"children":"Mi lectura personal de seis noticias de inteligencia artificial: pymes que no la usan, gigafactorías, el reglamento europeo aplazado, laboratorios que salen a bolsa y modelos capaces de atacar."}]]}]}],["$","li","como-trabajo-con-agentes-de-ia",{"children":["$","$Lf",null,{"href":"/blog/como-trabajo-con-agentes-de-ia","children":[["$","strong",null,{"children":"Cómo trabajo con agentes de IA: ellos escriben, yo decido"}],["$","span",null,{"children":"Mi forma de trabajar con agentes que programan: especificación antes del código, pruebas de extremo a extremo, despliegue con puerta de salud y registro de cada hora."}]]}]}],["$","li","accuracy-no-es-una-metrica",{"children":["$","$Lf",null,{"href":"/blog/accuracy-no-es-una-metrica","children":[["$","strong",null,{"children":"Accuracy no es una métrica: cómo leo un modelo de clasificación"}],["$","span",null,{"children":"Con datos desbalanceados, la accuracy engaña. Así comparo modelos de machine learning: mismo preprocesado, modelo base, classification_report y matriz de confusión."}]]}]}],["$","li","deep-learning-de-principio-a-fin",{"children":["$","$Lf",null,{"href":"/blog/deep-learning-de-principio-a-fin","children":[["$","strong",null,{"children":"Deep learning de principio a fin: lo que aprendí entrenando mis propias redes"}],["$","span",null,{"children":"Redes convolucionales para caras y emociones, ResNet con transferencia de aprendizaje, aprendizaje por refuerzo y redes de grafos sobre bases de datos. Lo que me enseñó cada proyecto."}]]}]}],["$","li","rag-y-modelos-en-local",{"children":"$L1d"}]]}]]}]
