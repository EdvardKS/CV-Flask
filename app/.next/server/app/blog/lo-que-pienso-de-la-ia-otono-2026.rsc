4:["$","div",null,{"className":"doc-page","children":[["$","script",null,{"dangerouslySetInnerHTML":{"__html":"if(window.self!==window.top)document.documentElement.classList.add('is-embedded')"}}],["$","header",null,{"className":"doc-top","children":[["$","$Lf",null,{"href":"/","className":"doc-brand","children":["EdvardKS ",["$","span",null,{"children":"PC"}]]}],["$","nav",null,{"aria-label":"Secciones","children":[["$","$Lf","/",{"href":"/","children":"Escritorio"}],["$","$Lf","/projects",{"href":"/projects","children":"Proyectos"}],["$","$Lf","/blog",{"href":"/blog","children":"Blog"}],["$","$Lf","/cv",{"href":"/cv","children":"CV"}],["$","$Lf","/contact",{"href":"/contact","children":"Contacto"}]]}]]}],["$","main",null,{"className":"doc-main","children":[["$","nav",null,{"className":"doc-crumbs","aria-label":"Ruta","children":[["$","$Lf",null,{"href":"/","children":"Inicio"}],["$","span",null,{"children":"/"}],["$","$Lf",null,{"href":"/blog","children":"Blog"}]]}],["$","article",null,{"className":"doc-article","children":[["$","p",null,{"className":"doc-eyebrow","children":["Actualidad"," · ","2026-10-13"," · ",5," min"]}],["$","h1",null,{"children":"Lo que pienso de la IA este otoño: España, Europa y Silicon Valley"}],["$","p",null,{"className":"doc-lead","children":"Mi lectura personal de seis noticias de inteligencia artificial: pymes que no la usan, gigafactorías, el reglamento europeo aplazado, laboratorios que salen a bolsa y modelos capaces de atacar."}],["$","figure",null,{"className":"doc-figure","children":[["$","img",null,{"className":"doc-cover","src":"/blog/madrid-atardecer.webp","alt":"Atardecer sobre el centro de Madrid","width":1280,"height":800}],["$","figcaption",null,{"children":["Foto:"," ",["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:De_Madrid_al_cielo_81.jpg","target":"_blank","rel":"noopener nofollow","children":"José Manuel Suárez, CC BY 2.0, vía Wikimedia Commons"}]]}]]}],[["$","p","0",{"children":"Sigo la actualidad de la IA con una sola pregunta: qué cambia esto en lo que hago mañana. Casi nada pasa ese filtro. Estas seis noticias sí, y he escrito sobre cada una con detalle en el blog de mi consultora. Aquí va la versión corta y más personal."}],["$","h2","1",{"children":"España: el problema no es saber, es hacer"}],["$","p","2",{"children":"Solo una de cada veinticinco pymes industriales usa IA de verdad, y a la vez el país aspira a una gigafactoría con cien mil chips. Las dos cosas son ciertas y no se contradicen, pero me quedo con la primera. Me dedico a esto y lo veo cada semana: lo que falta no es cómputo, es alguien que deje un proceso funcionando."}],["$","h2","3",{"children":"Europa: construir bien sale más barato que cumplir tarde"}],["$","p","4",{"children":"El reglamento de IA aplaza el alto riesgo y Europa pone dinero para siete gigafactorías con chips comprados fuera. Mi postura es poco épica: permisos, registro y control de datos desde el primer día. Así da igual cuándo llegue la obligación."}],["$","h2","5",{"children":"Silicon Valley: no casarse con nadie"}],["$","p","6",{"children":"Los laboratorios salen a bolsa y uno de ellos ha lanzado un modelo que él mismo considera de riesgo crítico en ciberseguridad. De lo primero saco una regla: diseñar para poder cambiar de modelo. De lo segundo, otra: atacar se ha abaratado para todos, así que la seguridad básica ya no es opcional para nadie."}],["$","h2","7",{"children":"Mi resumen"}],["$","ul","8",{"className":"doc-list","children":[["$","li","Empezar por un proceso pequeño y real, no por una estrategia.",{"children":"Empezar por un proceso pequeño y real, no por una estrategia."}],["$","li","Tratar los datos como si la ley ya obligase.",{"children":"Tratar los datos como si la ley ya obligase."}],["$","li","No depender de un único proveedor.",{"children":"No depender de un único proveedor."}],["$","li","Dedicar una tarde a la seguridad antes de dedicar un mes a la IA.",{"children":"Dedicar una tarde a la seguridad antes de dedicar un mes a la IA."}]]}],"$L10"]]}],"$L11",["$L12","$L13"]]}],"$L14"]}]
