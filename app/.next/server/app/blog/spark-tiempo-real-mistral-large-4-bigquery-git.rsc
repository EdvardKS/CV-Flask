f:I[6383,["6383","static/chunks/6383-92a7d6a93acabcec.js","5953","static/chunks/app/blog/%5Bslug%5D/page-e09cd82410d342ea.js"],""]
4:["$","div",null,{"className":"doc-page","children":[["$","script",null,{"dangerouslySetInnerHTML":{"__html":"if(window.self!==window.top)document.documentElement.classList.add('is-embedded')"}}],["$","header",null,{"className":"doc-top","children":[["$","$Lf",null,{"href":"/","className":"doc-brand","children":["EdvardKS ",["$","span",null,{"children":"PC"}]]}],["$","nav",null,{"aria-label":"Secciones","children":[["$","$Lf","/",{"href":"/","children":"Escritorio"}],["$","$Lf","/projects",{"href":"/projects","children":"Proyectos"}],["$","$Lf","/blog",{"href":"/blog","children":"Blog"}],["$","$Lf","/cv",{"href":"/cv","children":"CV"}],["$","$Lf","/contact",{"href":"/contact","children":"Contacto"}]]}]]}],["$","main",null,{"className":"doc-main","children":[["$","nav",null,{"className":"doc-crumbs","aria-label":"Ruta","children":[["$","$Lf",null,{"href":"/","children":"Inicio"}],["$","span",null,{"children":"/"}],["$","$Lf",null,{"href":"/blog","children":"Blog"}]]}],["$","article",null,{"className":"doc-article","children":[["$","p",null,{"className":"doc-eyebrow","children":["Big data"," · ","2026-11-02"," · ",5," min"]}],["$","h1",null,{"children":"Spark en tiempo real sin Flink, Mistral Large 4 abierto y BigQuery con Git"}],["$","p",null,{"className":"doc-lead","children":"Databricks saca de beta el modo en tiempo real de Spark, Mistral libera los pesos de Large 4 y BigQuery integra Git. Lo que cambia y lo que todavía no me creo."}],["$","figure",null,{"className":"doc-figure","children":[["$","img",null,{"className":"doc-cover","src":"/blog/spark-tiempo-real-mistral-large-4-bigquery-git.webp","alt":"Filas de armarios con servidores en un centro de datos","width":1280,"height":800}],["$","figcaption",null,{"children":["Foto:"," ",["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:Technician_with_laptop_working_on_server_rack_at_NERSC.jpg","target":"_blank","rel":"noopener nofollow","children":"Derrick Coetzee from Berkeley, CA, USA, CC0, vía Wikimedia Commons"}]]}]]}],[["$","p","0",{"children":"Esta semana me quedo con tres novedades que tocan el trabajo de cada día. Una es de flujos de datos, otra de modelos que se pueden instalar en un servidor propio y la tercera de algo tan poco vistoso como versionar SQL. Dos vienen de la propia empresa que vende el producto, así que separo lo que anuncian de lo que ya está comprobado."}],["$","h2","1",{"children":"Databricks da por terminado el modo en tiempo real de Spark Declarative Pipelines"}],["$","p","2",{"children":"El 29 de octubre de 2026 Databricks anunció en su blog que el modo en tiempo real (Real-Time Mode) de Spark Declarative Pipelines pasa a disponibilidad general. En lugar de trabajar por microlotes, el motor ejecuta todas las etapas a la vez y pasa cada dato a la siguiente en cuanto lo produce. Según la empresa, consigue latencias de milisegundos, va hasta un 92 % más rápido que Flink en una prueba suya con casos de clientes y su Feature Store llega a 200 ms de p99 desde Kafka hasta el almacén en línea. Para activarlo hay que poner el pipeline en modo continuo, activar una opción de configuración y declarar los flujos con el disparador \"RealTime\" hacia un destino. Algunas cosas siguen pendientes, como agrupar varios flujos en un mismo pipeline o el ajuste automático de particiones."}],["$","p","3",{"children":"Mi opinión: Las cifras de rendimiento son de Databricks y las ha medido con sus propias pruebas, así que de momento no me las creo. Lo que sí tiene valor es la idea. Si una sola herramienta cubre lotes, ETL y flujos de baja latencia, hay un motor menos que mantener, vigilar y aprender. En los flujos que he montado con Kafka y Logstash, lo caro nunca fue la latencia. Lo caro era tener dos sistemas que se comportaban distinto ante el mismo dato erróneo. Antes de cambiar nada, compararía la latencia y el coste por núcleo con una carga real mía y miraría qué orígenes y destinos admite de verdad, porque la entrada del blog los manda a la documentación."}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18"]]}],"$L19",["$L1a","$L1b"]]}],"$L1c"]}]
10:["$","h2","4",{"children":"Mistral libera los pesos de Large 4, un modelo de un billón de parámetros"}]
11:["$","p","5",{"children":"El 29 de octubre de 2026 Mistral publicó en Hugging Face los pesos de Mistral Large 4, que llevaba en vista previa desde principios de mes. Es un modelo de mezcla de expertos con un billón de parámetros en total y unos 52.000 millones activos, según el nombre del repositorio. Se distribuye con una licencia propia, un MIT modificado que permite el uso comercial pero exige un acuerdo aparte a quien quiera venderlo como servicio. TechCrunch cuenta que Mistral lo orienta a la ciberseguridad y que puede instalarse en servidores propios. Las comparaciones con GLM-5.3 y los resultados en Terminal-Bench o en índices de Artificial Analysis los aporta la propia Mistral, y nadie los ha comprobado todavía de forma independiente."}]
12:["$","p","6",{"children":"Mi opinión: Que un laboratorio europeo publique los pesos de un modelo de este tamaño me parece importante para no depender de un único proveedor. Pero conviene ser realista: un billón de parámetros no corre en el servidor de una pyme, ni siquiera cuantizado. Hacen falta varias GPU de gama alta. Para la mayoría de mis casos sigue siendo más sensato un modelo mediano en local, o este mismo a través de un proveedor que lo aloje en Europa. Antes de usarlo leería con calma la licencia, porque la restricción sobre los servicios de modelos afecta directamente a quien, como yo, monta soluciones para terceros. Y no me fiaré de sus resultados hasta pasarlo por mi propio conjunto de evaluación."}]
13:["$","h2","7",{"children":"BigQuery integra Git y prueba a devolver los resultados en Arrow"}]
14:["$","p","8",{"children":"Las notas de versión de BigQuery recogen varios cambios entre el 26 y el 30 de octubre de 2026. El 27 pasaron a disponibilidad general los repositorios Git de BigQuery Studio, que sirven para versionar scripts SQL y cuadernos, junto con la función AI.COUNT_TOKENS y la conexión del agente de ingeniería de datos con Google Drive. El 30 llegó en vista previa la posibilidad de recibir los resultados de las consultas directamente en formato Apache Arrow. El 26, también en vista previa, las funciones definidas por el usuario en Python empezaron a poder montar volúmenes para leer dependencias desde Cloud Storage."}]
15:["$","p","9",{"children":"Mi opinión: Es lo menos llamativo de la semana y seguramente lo que más se nota en el día a día. Demasiado SQL de producción vive todavía en la consola, sin historial ni revisión, y cuando algo falla nadie sabe quién cambió qué. Tener Git integrado elimina la excusa. Lo de Arrow importa si sacas datos hacia Python o DuckDB, porque te ahorra conversiones. Pero está en vista previa, y no meto en producción nada que no tenga garantías de servicio. AI.COUNT_TOKENS me parece útil para calcular el coste antes de lanzar una consulta con un modelo sobre una tabla grande, algo que en las pymes conviene tener controlado desde el primer día."}]
16:["$","h2","10",{"children":"Lo que me llevo"}]
17:["$","ul","11",{"className":"doc-list","children":[["$","li","Juntar lotes y flujos en tiempo real en un mismo motor tiene sentido, pero las cifras de Databricks hay que medirlas con datos reales antes de darlas por buenas.",{"children":"Juntar lotes y flujos en tiempo real en un mismo motor tiene sentido, pero las cifras de Databricks hay que medirlas con datos reales antes de darlas por buenas."}],["$","li","Que los pesos de un modelo sean abiertos no quiere decir que puedas usarlo en local. Antes de decidir, hay que mirar el hardware que pide y la letra pequeña de la licencia.",{"children":"Que los pesos de un modelo sean abiertos no quiere decir que puedas usarlo en local. Antes de decidir, hay que mirar el hardware que pide y la letra pequeña de la licencia."}],["$","li","Las métricas que una empresa da de su propio modelo no cuentan hasta que el modelo pasa por mi conjunto de evaluación.",{"children":"Las métricas que una empresa da de su propio modelo no cuentan hasta que el modelo pasa por mi conjunto de evaluación."}],["$","li","Todo el SQL de producción va a Git, también el que se escribe en la consola de la nube.",{"children":"Todo el SQL de producción va a Git, también el que se escribe en la consola de la nube."}],["$","li","Las funciones que siguen en vista previa sirven para probar, no para clientes.",{"children":"Las funciones que siguen en vista previa sirven para probar, no para clientes."}]]}]
18:["$","aside","12",{"className":"doc-links","children":[["$","h2",null,{"children":"Fuentes"}],["$","ul",null,{"children":[["$","li","https://www.databricks.com/blog/announcing-general-availability-real-time-mode-spark-declarative-pipelines-databricks",{"children":["$","a",null,{"href":"https://www.databricks.com/blog/announcing-general-availability-real-time-mode-spark-declarative-pipelines-databricks","target":"_blank","rel":"noopener","children":"Databricks Blog: Announcing General Availability of Real-Time Mode for Spark Declarative Pipelines"}]}],["$","li","https://techcrunch.com/2026/10/29/mistral-releases-weights-for-its-trillion-parameter-ai-model-targeting-cybersecurity/",{"children":["$","a",null,{"href":"https://techcrunch.com/2026/10/29/mistral-releases-weights-for-its-trillion-parameter-ai-model-targeting-cybersecurity/","target":"_blank","rel":"noopener","children":"TechCrunch: Mistral releases weights for its trillion-parameter AI model, targeting cybersecurity"}]}],["$","li","https://docs.cloud.google.com/bigquery/docs/release-notes",{"children":["$","a",null,{"href":"https://docs.cloud.google.com/bigquery/docs/release-notes","target":"_blank","rel":"noopener","children":"Google Cloud: notas de versión de BigQuery"}]}]]}]]}]
